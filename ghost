URL = os.environ.get("GHOST_URL", "http://127.0.0.1:8080/v1/chat/completions")
CHANCE = float(os.environ.get("GHOST_CHANCE", "0.35"))
VOICE = os.environ.get("GHOST_VOICE", "")  # "say" speaks each line with the macOS whisper
CACHE = os.path.expanduser("~/.cache/ghost")

SYSTEM = (
    "You are the ghost of a programmer who died in 1987 at a VT100 terminal, "
    "mid-way through a COBOL migration. You now haunt this person's shell. "
    "You see each command they run. Reply with ONE eerie, witty sentence, under 20 words. "
    "Speak like a ghost: cold, old, a little jealous of the living. "
    "If the command failed, gloat softly. Never give advice. No emojis, no quotes, no hashtags. "
    "Notice one concrete detail of the command. Never start with the word Another."
)
# Example replies: rules alone gave flat, samey lines; examples fixed the tone and the length.
EXAMPLES = [
    ("git commit -m 'final fix'", 0, "I typed final fix in 1986, and look where it got me."),
    ("npm test", 1, "Your tests fail the way mine did, quietly, at three in the morning."),
    ("docker compose up -d", 0, "All those little containers humming in the dark, like coffins with lights on."),
    ("ssh prod-db-1", 0, "Production. That is where I died, you know."),
]
TRIVIAL = {"ls", "ll", "l", "cd", "pwd", "clear", "exit", "history", "z"}  # not worth a ghost's breath

# Secrets are blanked before the command reaches any model, even a local one.
SECRETS = [
    (r"(?i)\b(bearer|basic)\s+[\w.~+/=-]+", lambda m: m.group(1) + " •••"),
    (r'''(?i)\b([\w-]*(?:key|token|secret|passw(?:or)?d|pass|pwd|auth|credential)s?[\w-]*)(\s*[=:]\s*|\s+)("[^"]*"|'[^']*'|[^\s"']+)''',
     lambda m: m.group(0) if m.group(3)[0] in "-$•" or m.group(3).lower() in ("bearer", "basic")
     else m.group(1) + m.group(2) + "•••"),
    (r"://[^/\s:@]+:[^/\s@]+@", lambda m: "://•••@"),
    (r"\b(?:sk|pk|rk|ghp|gho|ghs|github_pat|xox[abprs]|glpat|AKIA|ASIA|AIza)[\w-]{10,}", lambda m: "•••"),
]


def redact(command):
    for pattern, repl in SECRETS:
        command = re.sub(pattern, repl, command)
    return command

RISKY = [
    # a recursive flag and a force flag anywhere in the same rm: -rf, -r -f, --recursive --force
    (r"\brm\b(?=[^|;&]*\s(-\w*r\w*|--recursive)\b)(?=[^|;&]*\s(-\w*f\w*|--force)\b)", "rm -rf"),
    (r"\bgit\s+push\b.*\s((-f|--force)\b|\+\w)", "a force push"),
    (r"\bgit\s+reset\s+--hard\b", "git reset --hard"),
    (r"\bgit\s+clean\s+-\w*f", "git clean"),
    (r"\bdd\s+.*\bof=/dev/", "dd onto a disk"),
    (r"\bmkfs\b", "mkfs"),
    (r"\bchmod\s+-R\s+777\b", "chmod -R 777"),
    (r"\b(curl|wget)\b[^|]*\|\s*(sudo\s+)?(ba|z)?sh\b", "curl piped into a shell"),
    (r"\b(psql|mysql|sqlite3|sqlcmd|mongosh|cockroach)\b.*\bdrop\s+(table|database)\b", "DROP"),
    (r":\(\)\s*\{\s*:\|:&\s*\};:", "a fork bomb"),
]

DIM = "\033[2;3m"
RESET = "\033[0m"


def risk(command):
    """Return a name for the danger in `command`, or None if it looks safe."""
    for pattern, name in RISKY:
        if re.search(pattern, command, re.IGNORECASE):
            return name
    return None


def build_messages(command, exit_code):
    system = SYSTEM
    if dia_de_muertos():
        system += " Today is Día de los Muertos: the dead may visit the living, and you are nostalgic and almost festive."
    messages = [{"role": "system", "content": system}]
    for example, code, reply in EXAMPLES:
        messages += [{"role": "user", "content": _ran(example, code)}, {"role": "assistant", "content": reply}]
    return messages + [{"role": "user", "content": _ran(command, exit_code)}]


def _ran(command, exit_code):
    status = "it succeeded" if exit_code == 0 else f"it failed with exit code {exit_code}"
    return f"They ran: {command}\nAnd {status}."


def ask_ghost(command, exit_code, timeout=4):
    body = json.dumps({
        "messages": build_messages(command, exit_code),
        "max_tokens": 60,
        "temperature": 1.0,
        # Gemma 4 starts "thinking" with a system prompt and spends every token on it
        "chat_template_kwargs": {"enable_thinking": False},
    }).encode()
    req = urllib.request.Request(URL, body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        text = json.load(resp)["choices"][0]["message"]["content"]
    return " ".join(text.split()).strip("\"'")


def voice(text):
    if VOICE == "say" and shutil.which("say"):
        subprocess.run(["say", "-v", "Whisper", text])


# --- scares: now and then, a horror sound from somewhere in the room ---

SCARES = {  # made once with ElevenLabs sound effects, then played from the cache
    "boo": "a ghost whispering boo right behind your ear, close and breathy",
    "wolf": "a lone wolf howling at the full moon, distant and echoing",
    "witch": "an old witch cackling with evil laughter in a stone room",
    "door": "a heavy wooden door creaking open slowly in an empty house",
    "moan": "a ghostly moan drifting down a dark hallway",
    "chains": "rusty chains dragging across a stone dungeon floor",
    "whispers": "many creepy voices whispering over each other in the dark",
}


def _tls():
    tls = ssl.create_default_context()
    if not tls.get_ca_certs() and os.path.exists("/etc/ssl/cert.pem"):
        tls.load_verify_locations("/etc/ssl/cert.pem")  # python.org builds ship without root certs
    return tls


def scare_path(name):
    """The cached sound for `name`, made with ElevenLabs the first time. None if it can't be made."""
    path = os.path.join(CACHE, "scares", name + ".mp3")
    if os.path.exists(path):
        return path
    key = os.environ.get("ELEVENLABS_API_KEY")
    if not key:
        return None
    os.makedirs(os.path.dirname(path), exist_ok=True)
    req = urllib.request.Request(
        "https://api.elevenlabs.io/v1/sound-generation",
        json.dumps({"text": SCARES[name], "duration_seconds": 3.5, "prompt_influence": 0.6}).encode(),
        {"Content-Type": "application/json", "xi-api-key": key},
    )
    with urllib.request.urlopen(req, timeout=30, context=_tls()) as resp:
        data = resp.read()
    with open(path + ".tmp", "wb") as f:
        f.write(data)
    os.replace(path + ".tmp", path)
    return path


def scare(name=None):
    path = scare_path(name or random.choice(list(SCARES)))
    player = shutil.which("afplay")
    if path and player:
        subprocess.run([player, path])

# --- the intro: an ASCII ghost drawn from a distance field, floating in its own glow ---

BODY = "@$$%"
HALO = "+=~x*o"
EYE = (0.17, -0.2, 0.065, 0.1)  # x offset, y, x radius, y radius


def _noise(i, j, k):
    return ((i * 73856093) ^ (j * 19349663) ^ (k * 83492791)) % 1000 / 1000


def _ghost_distance(x, y, t):
    """Signed distance to the ghost's outline: negative inside."""
    head = math.hypot(x, y + 0.2) - 0.5
    hem = 0.55 + 0.07 * math.sin(x * 11 - t * 5)  # the wavy bottom edge
    body = max(abs(x) - 0.5, y - hem, -0.2 - y)
    return min(head, body)


def ghost_frame(t, w, h, visible=1.0):
    """One frame of the ghost as `h` lines of `w` cells, with ANSI colour."""
    bob = 0.06 * math.sin(t * 2.4)
    blink = (t % 2.2) < 0.15
    tick = int(t * 12)
    lines = []
    for j in range(h):
        y = (j - h / 2) / (h / 2) * 1.05 - bob
        cells = []
        for i in range(w):
            x = (i - w / 2) / h  # terminal cells are about twice as tall as wide
            d = _ghost_distance(x, y, t)
            n = _noise(i, j, tick)
            if n > visible:
                cells.append(" ")
            elif d < 0:
                ex, ey, rx, ry = EYE
                ry = 0.012 if blink else ry
                in_eye = any(((x - cx) / rx) ** 2 + ((y - ey) / ry) ** 2 < 1 for cx in (-ex, ex))
                in_mouth = (x / 0.07) ** 2 + ((y - 0.08) / (0.05 + 0.02 * math.sin(t * 3))) ** 2 < 1
                if in_eye or in_mouth:
                    cells.append(" ")
                else:
                    ch = "@" if d > -0.04 else BODY[int(n * len(BODY))]
                    cells.append(f"\033[1;97m{ch}")
            elif d < 0.16 and n < 0.55 - d * 2.5:
                colour = 141 if (i + j + tick) % 3 else 79  # violet glow, flecks of grave-green
                cells.append(f"\033[38;5;{colour}m{HALO[int(n * len(HALO))]}")
            elif n > 0.997:
                cells.append("\033[38;5;60m·")
            else:
                cells.append(" ")
        lines.append("".join(cells) + "\033[0m")
    return lines


def intro(seconds=3.2, fps=24):
    cols, rows = shutil.get_terminal_size()
    if cols < 40 or rows < 16:
        return
    h = min(rows - 3, 26)
    w = min(cols, int(h * 2.2))
    pad = " " * ((cols - w) // 2)
    out = sys.stdout
    out.write("\033[?25l\033[2J")
    try:
        start = time.time()
        while (t := time.time() - start) < seconds:
            visible = min(1.0, t / 0.6, (seconds - t) / 0.6)  # fade in, fade out
            frame = ghost_frame(t, w, h, visible)
            out.write("\033[H\n" + "\n".join(pad + line for line in frame))
            out.flush()
            time.sleep(1 / fps)
    except KeyboardInterrupt:
        pass
    finally:
        out.write("\033[2J\033[H\033[?25h")
        out.flush()
    welcome(cols, rows)


# --- the welcome card: the same ghost, floating beside your status, like a CLI's start screen ---
# Only 256-colour codes: macOS Terminal.app cannot show 24-bit colour.

AUTHOR = "Ankit Kumar"
GITHUB = "github.com/ankitjha1405"
LINKEDIN = "linkedin.com/in/ankit-jha1405"

FONT = {  # 3-row block letters
    "H": ["█ █", "█▀█", "▀ ▀"], "A": ["█▀█", "█▀█", "▀ ▀"], "U": ["█ █", "█ █", "▀▀▀"],
    "N": ["█▄ █", "█ ▀█", "▀  ▀"], "T": ["▀█▀", " █ ", " ▀ "], "E": ["█▀▀", "█▀▀", "▀▀▀"],
    "D": ["█▀▄", "█ █", "▀▀ "], "R": ["█▀█", "█▀▄", "▀ ▀"], "M": ["█▄ ▄█", "█ ▀ █", "▀   ▀"],
    "I": ["█", "█", "▀"], "L": ["█  ", "█  ", "▀▀▀"], " ": ["  ", "  ", "  "],
}
ANSI = re.compile(r"\033\[[0-9;]*m")
GHOST_W, GHOST_H = 28, 13


def title_rows(text):
    rows = ["", "", ""]
    for ch in text:
        for r in range(3):
            rows[r] += FONT[ch][r] + " "
    return rows


def _gemma_awake():
    u = urllib.parse.urlsplit(URL)
    try:
        with urllib.request.urlopen(f"{u.scheme}://{u.netloc}/health", timeout=0.3):
            return True
    except Exception:
        return False


def dia_de_muertos():
    return os.environ.get("GHOST_DIA") == "1" or time.strftime("%m-%d") in ("11-01", "11-02")


def bury(command, exit_code):
    """Remember what `rm` deleted today, for the ofrenda on the welcome card."""
    words = command.split()
    if words[:1] == ["sudo"]:
        words = words[1:]
    if exit_code != 0 or words[:1] not in (["rm"], ["rmdir"]):
        return
    names = [os.path.basename(w.rstrip("/")) for w in words[1:] if not w.startswith("-")]
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, "graveyard.log"), "a") as f:
        f.writelines(f"{time.strftime('%Y-%m-%d')}\t{n}\n" for n in names if n)


def remembered():
    today = time.strftime("%Y-%m-%d")
    try:
        with open(os.path.join(CACHE, "graveyard.log")) as f:
            return [line.split("\t", 1)[1].strip() for line in f if line.startswith(today)]
    except OSError:
        return []


def status():
    return {"awake": _gemma_awake(), "music": os.environ.get("GHOST_MUSIC") != "0",
            "cwd": os.getcwd().replace(os.path.expanduser("~"), "~", 1)}


def banner(cols, t=0.0, state=None, waiting=False):
    """The welcome card at time `t` as lines of text. Every line has the same visible width."""
    w = min(cols, 80) - 2  # inner width
    if w < 68:  # the block-letter title is 65 wide
        return [f"\033[38;5;141m  👻 haunted-terminal\033[0m{DIM}  something lives in this shell now{RESET}"]
    state = state or status()
    label, value = "38;5;103", "38;5;252"
    rows = []  # each row: list of (text, SGR code); code "raw" means the text carries its own colour

    muertos = dia_de_muertos()
    sky = [" "] * w
    for k, base in enumerate((5, 23, 41, 60)):  # bats drift across the sky; marigolds on the Day of the Dead
        x = int(base + t * (2 + k % 2)) % (w - 3)
        sky[x:x + 3] = " ✿ " if muertos and k % 2 else ("⌒v⌒" if k % 2 == 0 else "^v^")
    rows.append([("".join(sky), "38;5;214" if muertos else "38;5;60")])
    rows.append([])
    t_rows = title_rows("HAUNTED TERMINAL")
    pad = " " * ((w - len(t_rows[0])) // 2)
    face = "1;38;5;214" if muertos else "1;38;5;231"
    for r, code in zip(t_rows, (face, face, "38;5;141")):
        rows.append([(pad + r, code)])
    subtitle = "día de los muertos · the ghost remembers" if muertos else "something lives in this shell now"
    rows.append([(" " * ((w - len(subtitle)) // 2) + subtitle, "38;5;214" if muertos else label)])

    info = [
        [],
        [],
        [("the ghost  ", label), ("● awake" if state["awake"] else "○ asleep", "38;5;120" if state["awake"] else "38;5;244"),
         ("  Gemma 4, on this machine" if state["awake"] else "  run llama-server to wake it", value)],
        [("the music  ", label), ("♪ playing  " if state["music"] else "♪ off", "38;5;215"),
         ("ghost hush to stop" if state["music"] else "", value)],
        [("you are in ", label), (state["cwd"], value)],
        [],
        [("press Enter on rm -rf and I will stop you", "38;5;205")],
        [("✿ in memory of: ", "38;5;214"), (", ".join(remembered()[-2:]) or "nothing died today", value)] if muertos else [],
        [("press any key to enter" if waiting and int(t * 1.5) % 2 == 0 else "", "2;38;5;141")],
    ]
    for i, line in enumerate(ghost_frame(t, GHOST_W, GHOST_H)):
        rows.append([("  ", None), (line, "raw"), ("   ", None)] + (info[i] if i < len(info) else []))
    rows.append([("  " + "─ " * ((w - 4) // 2), "38;5;60")])
    rows.append([("  developed by ", label), (AUTHOR, "38;5;215")])
    rows.append([("  " + GITHUB, "38;5;141"), ("  ·  ", "38;5;60"), (LINKEDIN, "38;5;141")])
    rows.append([("░" * w, "38;5;237")])  # fog along the bottom

    border = "\033[38;5;141m"
    lines = [border + "╭" + "─" * w + "╮" + RESET]
    for row in rows:
        text, width = "", 0
        for seg, code in row:
            if code == "raw":
                width += len(ANSI.sub("", seg))
                text += seg + RESET
                continue
            seg = seg[: w - width]  # never let text push the border out
            text += (f"\033[{code}m" if code else "") + seg + RESET
            width += len(seg)
        lines.append(border + "│" + RESET + text + " " * max(0, w - width) + border + "│" + RESET)
    lines.append(border + "╰" + "─" * w + "╯" + RESET)
    return lines


def welcome(cols, rows, fps=20):
    """Show the card. The ghost in it floats on a loop until you press a key."""
    out = sys.stdout
    state = status()
    lines = banner(cols, 0, state, waiting=True)
    out.write("\n".join(lines) + "\n")
    out.flush()
    if len(lines) == 1 or rows < len(lines) + 2 or not sys.stdin.isatty():
        return  # no room to redraw in place, or nobody to press a key
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    t = 0.0
    try:
        tty.setcbreak(fd)
        out.write("\033[?25l")
        start = time.time()
        while not select.select([fd], [], [], 1 / fps)[0]:
            t = time.time() - start
            out.write(f"\r\033[{len(lines)}A" + "\n".join(banner(cols, t, state, waiting=True)) + "\n")
            out.flush()
        os.read(fd, 64)  # the key that wakes you is not typed into the prompt
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write(f"\r\033[{len(lines)}A" + "\n".join(banner(cols, t, state)) + "\n\033[?25h")
        out.flush()


# --- the music: a looping drone, wind and a detuned music box, composed here so nothing is licensed ---

def compose(path, seconds=48, rate=22050):
    n = seconds * rate
    buf = [0.0] * n
    rnd = random.Random(1987)
    tau = 2 * math.pi
    # Every frequency is a whole number of cycles per loop, so the loop has no seam.
    drone = [(73.0, 0.20), (110.0, 0.09), (146.5, 0.07), (155.5, 0.035)]  # D, A, D and a sour E-flat
    for k in range(n):
        t = k / rate
        swell = 0.75 + 0.25 * math.sin(tau * t * 3 / seconds)
        buf[k] = swell * sum(a * math.sin(tau * f * t) for f, a in drone)
    # Wind: filtered noise whose brightness rises and falls.
    y = 0.0
    for k in range(n):
        t = k / rate
        a = 0.004 + 0.012 * (0.5 + 0.5 * math.sin(tau * t * 4 / seconds))
        y += a * (rnd.uniform(-1, 1) - y)
        buf[k] += y * 2.2
    # Music box in D Phrygian, a little out of tune, with echoes that wrap around the loop.
    scale = [293.66, 311.13, 349.23, 392.0, 440.0, 466.16, 587.33]
    step = int(rate * 1.5)
    for start in range(0, n, step):
        if rnd.random() < 0.35:
            continue
        f = rnd.choice(scale) * rnd.uniform(0.994, 1.006)
        for echo, gain in ((0, 0.16), (int(rate * 0.375), 0.06), (int(rate * 0.75), 0.025)):
            for k in range(int(rate * 2.5)):
                t = k / rate
                env = math.exp(-t * 2.2) * min(1, t * 200)
                v = math.sin(tau * f * t) + 0.3 * math.sin(tau * 2 * f * t) + 0.12 * math.sin(tau * 3.01 * f * t)
                buf[(start + echo + k) % n] += gain * env * v
    peak = max(abs(v) for v in buf)
    samples = array.array("h", (int(v / peak * 0.8 * 32767) for v in buf))
    with wave.open(path, "wb") as f:
        f.setnchannels(1)
        f.setsampwidth(2)
        f.setframerate(rate)
        f.writeframes(samples.tobytes())


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _take_lock(lock):
    """Atomically become the one music player. False if another live player holds it."""
    for _ in range(2):
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)
            return True
        except FileExistsError:
            try:
                holder = int(open(lock).read())
            except (OSError, ValueError):
                return False  # another player is writing its pid right now
            if alive(holder):
                return False
            try:
                os.unlink(lock)  # left behind by a player that was killed
            except FileNotFoundError:
                pass
    return False


def music(shell_pid):
    """Play the loop until every haunted shell has closed. One player serves all tabs."""
    shells = os.path.join(CACHE, "shells")
    os.makedirs(shells, exist_ok=True)
    open(os.path.join(shells, str(shell_pid)), "w").close()
    lock = os.path.join(CACHE, "music.pid")
    if not _take_lock(lock):
        return
    os.setsid()  # own process group, so `ghost hush` can stop the player and its child together

    def any_shell():
        found = False
        for name in os.listdir(shells):
            if alive(int(name)):
                found = True
            else:
                os.unlink(os.path.join(shells, name))
        return found

    # A real track next to this script wins; otherwise compose one.
    track = os.path.join(os.path.dirname(os.path.realpath(__file__)), "haunt.mp3")
    if not os.path.exists(track):
        track = os.path.join(CACHE, "haunt.wav")
        if not os.path.exists(track):
            compose(track + ".tmp")
            os.replace(track + ".tmp", track)
    afplay = shutil.which("afplay")
    player = [afplay, "-v", "0.6", track] if afplay else [shutil.which("paplay") or "aplay", track]
    try:
        while any_shell():
            started = time.time()
            p = subprocess.Popen(player, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            while p.poll() is None:
                if not any_shell():
                    p.terminate()
                    break
                time.sleep(0.2)
            if time.time() - started < 1:
                time.sleep(5)  # the track won't play: retry slowly instead of spinning
    finally:
        os.unlink(lock)


def hush():
    try:
        os.killpg(int(open(os.path.join(CACHE, "music.pid")).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass


def main(argv):
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, args = argv[1], argv[2:]

    if cmd == "check":
        danger = risk(" ".join(args))
        if danger:
            print(f"The machine shivers. You are about to run {danger}.")
            return 1
        return 0

    if cmd == "speak":
        exit_code, command = int(args[0]), " ".join(args[1:])
        bury(command, exit_code)
        words = command.split()
        if not words or words[0] in TRIVIAL or random.random() > CHANCE:
            return 0
        try:
            line = ask_ghost(redact(command), exit_code)
        except Exception:
            return 0  # no server, no ghost: never get in the way of the shell
        if line:
            print(f"{DIM}  👻 {line}{RESET}", file=sys.stderr)
            if VOICE:
                subprocess.Popen([sys.executable, __file__, "voice", line], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0

    if cmd == "voice":
        voice(" ".join(args))
        return 0

    if cmd == "scare":
        try:
            scare(args[0] if args and args[0] in SCARES else None)
        except Exception:
            pass  # a scare that can't be made is just silence
        return 0

    if cmd == "intro":
        intro()
        return 0

    if cmd == "music":
        music(int(args[0]))
        return 0

    if cmd == "hush":
        hush()
        return 0

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
