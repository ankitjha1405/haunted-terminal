#!/usr/bin/env python3
"""ghost: a spirit that haunts your zsh, powered by Gemma running on your own machine.

  ghost speak <exit_code> <command>   comment on a command that just ran
  ghost check <command>               exit 1 and print a warning if the command is risky
  ghost voice <text>                  say a line aloud (used internally, runs in the background)
  ghost scare [name]                  play a horror sound: boo, wolf, witch, door, moan, chains, whispers
  ghost intro                         play the ghost animation
  ghost music <shell_pid>             loop the haunting music while haunted shells are open
  ghost hush                          stop the music
"""
import array
import json
import math
import os
import random
import re
import shutil
import signal
import ssl
import subprocess
import sys
import time
import urllib.parse
import urllib.request
